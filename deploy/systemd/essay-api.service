[Unit]
Description=Essay Annotator API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=essay-api
Group=essay-api
WorkingDirectory=/opt/essay-annotator/current/BackEnd
EnvironmentFile=/etc/essay-annotator/production.env
ExecStart=/opt/essay-annotator/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/essay-annotator
UMask=0027

[Install]
WantedBy=multi-user.target
